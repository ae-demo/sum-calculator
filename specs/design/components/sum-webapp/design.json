{
  "name": "sum-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "sum-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F1.5"
  ],
  "description": "Single-page app, the only user-facing surface: a signed-in user enters two numbers, submits, and sees the sum below the form. It validates empty or non-numeric input before sending, shows a message when the sum service is unavailable, and never calculates the sum itself. It stores nothing.",
  "dependencies": [
    {
      "kind": "component",
      "name": "sum-api",
      "wiring": {
        "endpoint": {
          "component": "sum-calculator-sum-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "SUM_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "sum-calculator-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
