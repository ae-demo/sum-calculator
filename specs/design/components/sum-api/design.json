{
  "name": "sum-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "sum-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.4"
  ],
  "description": "Stateless back service that adds two decimal numbers (negatives allowed) and returns the exact sum without rounding. It is a separate deployable because the requirements place the addition in a back service rather than the page. It stores nothing, keeps no history, and offers no operation other than addition.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "sum-calculator-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
